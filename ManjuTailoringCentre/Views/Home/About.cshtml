@{
    ViewData["Title"] = "About Us";
}

<section class="py-5" style="background: var(--bg-pink); min-height: 400px; display: flex; align-items: center; border-radius: 0 0 50px 50px;">
    <div class="container py-5 text-center fade-up">
        <h1 class="display-3 mb-4 fw-bold" style="font-family: var(--header-font); color: var(--primary-color);">Our Story & Expertise</h1>
        <p class="lead mx-auto" style="max-width: 800px;">Crafting excellence in every stitch. Manju Ladies Tailoring Centre represents years of tradition and a passion for modern design.</p>
    </div>
</section>

<div class="container py-5 mt-3">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-5 text-center fade-up">
            <div class="d-inline-block text-center">
                <img src="/images/shankaramma.jpg" alt="Shankaramma - Founder & Master Designer" class="img-fluid rounded-4 shadow-sm" style="max-height: 330px; width: auto; object-fit: cover; border: 3px solid var(--accent-color);" />
                <div class="mt-3">
                    <h5 class="fw-bold mb-1" style="color: var(--primary-color); font-size: 1.25rem;">Shankaramma</h5>
                    <p class="text-muted mb-0 small" style="font-weight: 500;">Founder & Master Designer</p>
                </div>
            </div>
        </div>
        <div class="col-lg-7 fade-up">
            <h2 class="display-4 mb-4" style="color: var(--primary-color);">Dedicated Craftsmanship in Gadwal</h2>
            <p class="lead text-muted mb-4">A legacy of perfection and community trust.</p>
            <p>At Manju Ladies Tailoring Centre, our journey began with a simple goal: to provide ladies and kids in Gadwal with a place where their outfits are treated with the utmost care, precision, and respect. Under the dedicated hands of Shankaramma, we have grown into one of the most loved tailoring shops in the region.</p>
            <p>From custom designer blouses and delicate kids' frocks to grand pattu langas, chudidhars, and festive gowns, every single cut and stitch is tailored for your perfect confidence.</p>
            <div class="row mt-4 g-3">
                <div class="col-6">
                    <div class="p-3 border rounded-4 text-center bg-white shadow-sm">
                        <h3 class="fw-bold mb-0" style="color: var(--accent-color);">15+</h3>
                        <small class="text-uppercase text-muted">Years Experience</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 border rounded-4 text-center bg-white shadow-sm">
                        <h3 class="fw-bold mb-0" style="color: var(--primary-color);">10,000+</h3>
                        <small class="text-uppercase text-muted">Happy Customers</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center mt-4">
        <div class="col-lg-8 fade-up">
            <div class="p-5" style="border: 2px solid var(--accent-color); border-radius: 30px; background: white; box-shadow: var(--premium-shadow);">
                <h4 class="mb-4 text-center" style="color: var(--primary-color);">Why Choose Manju Ladies Tailoring?</h4>
                <ul class="list-unstyled">
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-patch-check-fill text-success fs-4 me-3"></i>
                        <div>
                            <h6 class="mb-1 fw-bold">Perfect Fitting Guarantee</h6>
                            <p class="small text-muted mb-0">No more multiple visits. We get the fit right the first time.</p>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-patch-check-fill text-success fs-4 me-3"></i>
                        <div>
                            <h6 class="mb-1 fw-bold">Timely Delivery</h6>
                            <p class="small text-muted mb-0">We understand deadlines, especially for weddings and events.</p>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-patch-check-fill text-success fs-4 me-3"></i>
                        <div>
                            <h6 class="mb-1 fw-bold">Latest Design Trends</h6>
                            <p class="small text-muted mb-0">Stay ahead of the trend with our modern and ethnic blouse styles.</p>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-patch-check-fill text-success fs-4 me-3"></i>
                        <div>
                            <h6 class="mb-1 fw-bold">Affordable Premium Craft</h6>
                            <p class="small text-muted mb-0">Premium tailoring doesn't have to be expensive.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
