@{
    ViewData["Title"] = "About Us";
}

<section class="py-5" style="background: var(--bg-pink); min-height: 400px; display: flex; align-items: center; border-radius: 0 0 50px 50px;">
    <div class="container py-5 text-center fade-up">
        <h1 class="display-3 mb-4 fw-bold" style="font-family: var(--header-font); color: var(--primary-color);">Our Story & Expertise</h1>
        <p class="lead mx-auto" style="max-width: 800px;">Crafting excellence in every stitch. Manju Ladies Tailoring Centre represents years of tradition and a passion for modern design.</p>
    </div>
</section>

<div class="container py-5 mt-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6 fade-up">
            <h2 class="display-4 mb-4" style="color: var(--primary-color);">Managed by Shankaramma</h2>
            <p class="lead text-muted mb-4">A legacy of perfection in Gadwal.</p>
            <p>At Manju Ladies Tailoring Centre, our journey began with a simple goal: to provide ladies in Gadwal with a place where their outfits are treated with the utmost care and precision. Under the leadership of Shankaramma, we've grown into a trusted community name.</p>
            <p>We believe that every woman deserves an outfit that fits her perfectly and reflects her unique style. That's why we focus on high-quality stitching, perfect measurements, and trending designs, especially for marriages and special festivals.</p>
            <div class="row mt-5 g-4">
                <div class="col-6">
                    <div class="p-4 border rounded-4 text-center">
                        <h3 class="fw-bold" style="color: var(--accent-color);">15+</h3>
                        <small class="text-uppercase text-muted">Years Experience</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-4 border rounded-4 text-center">
                        <h3 class="fw-bold" style="color: var(--accent-color);">High</h3>
                        <small class="text-uppercase text-muted">Quality Threads</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 fade-up">
            <div class="p-5" style="border: 2px solid var(--accent-color); border-radius: 30px; background: white; box-shadow: var(--premium-shadow);">
                <h4 class="mb-4">Why Choose Us?</h4>
                <ul class="list-unstyled">
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-patch-check-fill text-success fs-4 me-3"></i>
                        <div>
                            <h6 class="mb-1 fw-bold">Perfect Fitting Guarantee</h6>
                            <p class="small text-muted mb-0">No more multiple visits. We get the fit right the first time.</p>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-patch-check-fill text-success fs-4 me-3"></i>
                        <div>
                            <h6 class="mb-1 fw-bold">Timely Delivery</h6>
                            <p class="small text-muted mb-0">We understand deadlines, especially for weddings and events.</p>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-patch-check-fill text-success fs-4 me-3"></i>
                        <div>
                            <h6 class="mb-1 fw-bold">Latest Design Trends</h6>
                            <p class="small text-muted mb-0">Stay ahead of the trend with our modern and ethnic blouse styles.</p>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-patch-check-fill text-success fs-4 me-3"></i>
                        <div>
                            <h6 class="mb-1 fw-bold">Affordable Premium Craft</h6>
                            <p class="small text-muted mb-0">Premium tailoring doesn't have to be expensive.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
