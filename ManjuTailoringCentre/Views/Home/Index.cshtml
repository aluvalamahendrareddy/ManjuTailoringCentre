@using ManjuTailoringCentre.Models
@{
    ViewData["Title"] = "Home";
    var services = ViewBag.Services as List<ServiceViewModel>;
    var reviews = ViewBag.Reviews as List<ReviewViewModel>;
}

<!-- Hero Section -->
<section class="hero">
    <div class="container hero-content">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0 fade-up">
                <h1 class="hero-title mb-4">Perfect Fit,<br><span class="text-accent" style="color: var(--accent-color);">Elegant Style</span></h1>
                <p class="lead mb-4 text-muted">Manju Ladies Tailoring Centre - Specialists in custom designer blouses, cute kids' dresses & frocks, chudidhars, and traditional pattu langa / half sarees crafted for every special moment.</p>
                <div class="d-flex gap-3">
                    <a asp-action="Contact" class="btn btn-primary">Book Appointment</a>
                    <a asp-action="Gallery" class="btn btn-outline-gold">View Designs</a>
                </div>
                <div class="mt-5 d-flex align-items-center gap-3">
                    <div class="avatar-group">
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                    </div>
                    <span class="small fw-bold">5.0 (200+ Reliable Reviews)</span>
                </div>
            </div>
            <div class="col-lg-6 position-relative fade-up text-center">
                <img src="/images/hero.png" class="img-fluid rounded-4 shadow-lg" alt="Tailoring Showcase">
                <div class="position-absolute bottom-0 end-0 bg-white p-3 rounded-4 shadow m-3 d-none d-md-block" style="border-left: 5px solid var(--accent-color);">
                    <p class="mb-0 fw-bold">10 AM - 8 PM</p>
                    <small class="text-muted">Monday - Saturday</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats / Highlights Section -->
<section class="py-5 bg-white border-bottom">
    <div class="container text-center">
        <div class="row g-4">
            <div class="col-md-3">
                <h2 class="fw-bold" style="color: var(--primary-color);">15+</h2>
                <p class="text-muted">Years of Experience</p>
            </div>
            <div class="col-md-3">
                <h2 class="fw-bold" style="color: var(--primary-color);">10k+</h2>
                <p class="text-muted">Dresses Stitched</p>
            </div>
            <div class="col-md-3">
                <h2 class="fw-bold" style="color: var(--primary-color);">100%</h2>
                <p class="text-muted">Fit Guarantee</p>
            </div>
            <div class="col-md-3">
                <h2 class="fw-bold" style="color: var(--primary-color);">Best</h2>
                <p class="text-muted">Price in Gadwal</p>
            </div>
        </div>
    </div>
</section>

<!-- Services Overview -->
<section class="py-5" id="services">
    <div class="container py-5">
        <div class="text-center mb-5 fade-up">
            <span class="text-uppercase fw-bold text-accent px-3 py-1 bg-light rounded-pill" style="color: var(--accent-color); font-size: 0.8rem;">Our Craftsmanship</span>
            <h2 class="mt-3 display-5">Tailoring Services We Provide</h2>
            <div class="mx-auto mt-2" style="width: 60px; height: 3px; background: var(--accent-color);"></div>
        </div>
        <div class="row g-4">
            @if(services != null) {
                @foreach (var service in services)
                {
                    <div class="col-md-3 fade-up">
                        <div class="service-card">
                            <i class="bi @service.Icon service-icon"></i>
                            <h4>@service.Title</h4>
                            <p class="text-muted small">@service.Description</p>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="text-center mt-5">
            <a asp-action="Services" class="btn btn-outline-dark px-4 rounded-pill">View All Services</a>
        </div>
    </div>
</section>

<!-- Featured Section - About Shankaramma -->
<section class="py-5" style="background: #fafafa;">
    <div class="container py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-5 fade-up text-center">
                <div class="d-inline-block text-center">
                    <img src="/images/shankaramma.jpg" alt="Shankaramma - Founder & Master Tailor" class="img-fluid rounded-4 shadow-sm" style="max-height: 330px; width: auto; object-fit: cover; border: 3px solid var(--accent-color);" />
                    <div class="mt-3">
                        <h5 class="fw-bold mb-1" style="color: var(--primary-color); font-size: 1.25rem;">Shankaramma</h5>
                        <p class="text-muted mb-0 small" style="font-weight: 500;">Founder & Master Designer</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-7 fade-up">
                <h2 class="display-6 mb-4">Dedicated to Precision and Craft</h2>
                <p class="lead">Under the expert management of Shankaramma, Manju Ladies Tailoring Centre has become the go-to destination for ladies in Gadwal looking for the perfect fit.</p>
                <p class="text-muted">We combine years of experience with modern trends to create blouses and dresses that aren't just clothes, but confidence boosters. Our workshop in Gandhi Chowk specializes in traditional Gadwal saree fitting and designer bridal work.</p>
                <ul class="list-unstyled mb-4">
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> Quality high-speed Japanese machines</li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> Experienced tailors and handwork artists</li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> Same-day alteration services available</li>
                </ul>
                <a asp-action="About" class="btn btn-primary px-5 rounded-pill shadow">Read Our Story</a>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="py-5 mb-5 bg-white">
    <div class="container py-5">
        <div class="text-center mb-5 fade-up">
            <h2 class="display-6 mb-3">What Our Customers Say</h2>
            <div class="mx-auto" style="width: 50px; height: 3px; background: var(--accent-color);"></div>
        </div>
        <div id="reviewCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                @if(reviews != null) {
                    for(int i=0; i < reviews.Count; i++) {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="review-item text-center mx-auto" style="max-width: 600px;">
                                <i class="bi bi-quote fs-1" style="color: var(--accent-color);"></i>
                                <p class="lead italic">"@reviews[i].Comment"</p>
                                <div class="mt-4">
                                    <h5 class="mb-0 fw-bold">@reviews[i].Author</h5>
                                    <div class="text-warning small mt-2">
                                        @for(int r=0; r < reviews[i].Rating; r++) { <i class="bi bi-star-fill"></i> }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#reviewCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon bg-dark rounded-circle" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#reviewCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon bg-dark rounded-circle" aria-hidden="true"></span>
            </button>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 mx-2 mx-md-3" style="background: linear-gradient(rgba(139,0,0,0.92), rgba(139,0,0,0.92)), url('/images/hero.png'); border-radius: 24px; background-size: cover; background-position: center; overflow: hidden;">
    <div class="container py-4 text-center text-white">
        <div class="fade-up px-2">
            <h2 class="display-5 fw-bold mb-3">Ready to Get Your Custom Fit?</h2>
            <p class="lead mb-4 opacity-75 mx-auto" style="max-width: 650px;">
                Connect with us on WhatsApp or visit us at Gandhi Chowk for a consultation.
            </p>
            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center align-items-center">
                <a href="https://wa.me/919652848029" target="_blank" class="btn btn-light btn-lg px-4 py-3 rounded-pill shadow w-100 w-sm-auto" style="max-width: 300px; font-weight: 600;">
                    <i class="bi bi-whatsapp me-2 text-success fs-5 align-middle"></i>Contact via WhatsApp
                </a>
                <a asp-action="Contact" class="btn btn-outline-light btn-lg px-4 py-3 rounded-pill w-100 w-sm-auto" style="max-width: 300px; font-weight: 600;">
                    <i class="bi bi-geo-alt-fill me-2 fs-5 align-middle"></i>Locate on Map
                </a>
            </div>
        </div>
    </div>
</section>
