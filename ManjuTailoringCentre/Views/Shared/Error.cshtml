@model ErrorViewModel
@{
    var is404 = Model?.StatusCode == 404;
    ViewData["Title"] = is404 ? "Page Not Found (404)" : "Notice";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5" style="background: linear-gradient(180deg, #FFFFFF 0%, #FFF5F7 100%);">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" 
                         style="width: 100px; height: 100px; background-color: #FCE4EC; color: #C2185B;">
                        @if (is404)
                        {
                            <i class="bi bi-compass" style="font-size: 3rem;"></i>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-triangle" style="font-size: 3rem;"></i>
                        }
                    </div>
                </div>

                <div class="display-3 fw-bold mb-2" style="color: #C2185B; letter-spacing: 2px;">
                    @(Model?.StatusCode ?? 404)
                </div>

                <h2 class="fw-bold text-dark mb-3">
                    @(is404 ? "Page or Design Not Found" : "Something Went Wrong")
                </h2>

                <p class="text-muted fs-5 mb-4 mx-auto" style="max-width: 500px;">
                    @(Model?.Message ?? "The link you followed may be broken or the page may have been moved.")
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-3 mb-4">
                    <a href="/" class="btn btn-lg px-4 rounded-pill shadow-sm text-white" style="background-color: #C2185B;">
                        <i class="bi bi-house-door-fill me-2"></i> Back to Home
                    </a>
                    <a href="/Home/Gallery" class="btn btn-lg px-4 rounded-pill btn-outline-danger" style="border-color: #C2185B; color: #C2185B;">
                        <i class="bi bi-images me-2"></i> Browse Gallery
                    </a>
                    <a href="/Home/Contact" class="btn btn-lg px-4 rounded-pill btn-light border text-muted">
                        <i class="bi bi-telephone me-2"></i> Contact Us
                    </a>
                </div>

                <div class="pt-3 border-top text-muted small">
                    <span>Manju Ladies Tailoring Centre &bull; Shankaramma Garu &bull; Dharur, Vikarabad</span>
                    @if (Model?.ShowRequestId == true)
                    {
                        <div class="mt-2 text-muted" style="font-size: 0.75rem;">
                            Ref ID: <code>@Model.RequestId</code>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
