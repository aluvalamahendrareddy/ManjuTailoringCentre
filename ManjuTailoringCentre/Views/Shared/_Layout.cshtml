<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manju Ladies Tailoring Centre</title>

    <!-- Open Graph / WhatsApp Preview Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Manju Ladies Tailoring Centre, Gadwal" />
    <meta property="og:title" content="Manju Ladies Tailoring Centre – Designer Blouse & Ladies Specialist" />
    <meta property="og:description" content="Custom Designer Blouses, Cute Kids Dresses, Pattu Langa & Sarees stitched with 20+ years of perfection in Gadwal. Tap to view design gallery & order on WhatsApp!" />
    <meta property="og:image" content="https://manjuladiestailoringcentre.onrender.com/images/og-preview.jpg" />
    <meta property="og:image:secure_url" content="https://manjuladiestailoringcentre.onrender.com/images/og-preview.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Manju Ladies Tailoring Centre Designs" />
    <meta property="og:url" content="https://manjuladiestailoringcentre.onrender.com" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Manju Ladies Tailoring Centre – Designer Blouse Specialist" />
    <meta name="twitter:description" content="20+ Years of Craftsmanship in Gadwal. Designer blouses, kids frocks, sarees & custom ladies tailoring." />
    <meta name="twitter:image" content="https://manjuladiestailoringcentre.onrender.com/images/og-preview.jpg" />

    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html {
            scroll-behavior: smooth;
            scroll-padding-top: 72px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top shadow-sm">
            <div class="container text-uppercase">
                <a class="navbar-brand fs-4" href="#home">
                    <!-- Shown on mobile only (< 576px): Manju Tailoring with scissor icon on right -->
                    <span class="d-inline d-sm-none d-inline-flex align-items-center">
                        <span class="fw-bold">Manju Tailoring</span>
                        <i class="bi bi-scissors ms-1" style="font-size: 1rem; color: var(--accent-color);"></i>
                    </span>
                    <!-- Shown on tablet and desktop (>= 576px) -->
                    <span class="d-none d-sm-inline">
                        <span class="fw-bold">Manju</span> <span class="fw-light">Ladies Tailoring</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link active" href="#home">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#about">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#services">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#gallery">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contact">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3" style="margin-top: 72px;">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white pt-5 pb-3">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="text-uppercase mb-4 fw-bold" style="color: #d4af37;">Manju Ladies Tailoring</h5>
                    <p>Experience the perfect blend of tradition and trend. We specialize in crafting elegant outfits that make you feel confident and beautiful.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="text-uppercase mb-4 fw-bold" style="color: #d4af37;">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="#about" class="text-white-50 text-decoration-none">About Us</a></li>
                        <li><a href="#services" class="text-white-50 text-decoration-none">Our Services</a></li>
                        <li><a href="#gallery" class="text-white-50 text-decoration-none">Design Gallery</a></li>
                        <li><a href="#contact" class="text-white-50 text-decoration-none">Book Appointment</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="text-uppercase mb-4 fw-bold" style="color: #d4af37;">Contact Info</h5>
                    <p><i class="bi bi-geo-alt-fill me-2"></i> <a href="https://maps.app.goo.gl/LD6FH9GhYFP2bYsE7" target="_blank" class="text-white-50 text-decoration-none">Gandhi Chowk, Ashok Nagar, Gadwal, TS - 509125</a></p>
                    <p><i class="bi bi-clock-fill me-2"></i> Mon - Sat: 10:00 AM - 08:00 PM</p>
                    <p><i class="bi bi-building-fill-check me-2"></i> Landmark: Pallavi Herbal Beauty Parlour</p>
                    <div class="mt-3">
                        <a href="https://wa.me/919652848029" class="btn btn-outline-light btn-sm"><i class="bi bi-whatsapp me-2"></i>WhatsApp Us</a>
                    </div>
                </div>
            </div>
            <hr class="mt-4 mb-4 border-white-50">
            <div class="text-center text-white-50">
                <small>&copy; @DateTime.Now.Year Manju Ladies Tailoring Centre. Managed by Shankaramma. Crafted for Elegance.</small>
            </div>
        </div>
    </footer>

    <!-- WhatsApp Floating Button (Hidden on small mobile since bottom bar has WhatsApp, visible on tablet/desktop) -->
    <a href="https://wa.me/919652848029" class="whatsapp-float d-none d-md-flex" target="_blank" title="Chat on WhatsApp">
        <i class="bi bi-whatsapp"></i>
    </a>

    <!-- Mobile Bottom Navigation Bar (1-Tap Thumb Access for Mobile Users) -->
    <nav class="mobile-bottom-nav d-md-none">
        <a href="#home" class="nav-item-mobile active" id="mob-nav-home">
            <i class="bi bi-house-door"></i>
            <span>Home</span>
        </a>
        <a href="#services" class="nav-item-mobile" id="mob-nav-services">
            <i class="bi bi-scissors"></i>
            <span>Services</span>
        </a>
        <a href="#gallery" class="nav-item-mobile" id="mob-nav-gallery">
            <i class="bi bi-images"></i>
            <span>Gallery</span>
        </a>
        <a href="https://wa.me/919652848029" target="_blank" class="nav-item-mobile nav-wa-mobile">
            <i class="bi bi-whatsapp"></i>
            <span>WhatsApp</span>
        </a>
        <a href="tel:9652848029" class="nav-item-mobile nav-call-mobile">
            <i class="bi bi-telephone-fill"></i>
            <span>Call</span>
        </a>
    </nav>

    <!-- Global Floating Toast Notification (Replaces in-page banner on Laptop and Mobile) -->
    @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
    {
        <div class="toast-container position-fixed start-50 translate-middle-x p-2" style="z-index: 2050; bottom: 70px; width: max-content; max-width: 92vw;">
            <div id="siteToast" class="toast align-items-center text-white @(TempData["SuccessMessage"] != null ? "bg-success" : "bg-danger") border-0 rounded-pill px-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex align-items-center">
                    <div class="toast-body fw-bold py-2 px-1 text-center" style="font-size: 0.88rem; line-height: 1.3;">
                        <i class="bi @(TempData["SuccessMessage"] != null ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>@(TempData["SuccessMessage"] ?? TempData["ErrorMessage"])
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-2 me-1" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Smooth scroll spy for SPA top and mobile nav
        document.addEventListener('DOMContentLoaded', function () {
            // Auto show floating toast notification
            const siteToast = document.getElementById('siteToast');
            if (siteToast) {
                new bootstrap.Toast(siteToast, { delay: 4500 }).show();
            }

            const sections = document.querySelectorAll('section[id]');
            const topNavLinks = document.querySelectorAll('.navbar-nav .nav-link');
            const mobNavHome = document.getElementById('mob-nav-home');
            const mobNavGallery = document.getElementById('mob-nav-gallery');
            const mobNavServices = document.getElementById('mob-nav-services');

            // Collapse mobile navbar on link click
            topNavLinks.forEach(link => {
                link.addEventListener('click', () => {
                    const navbarCollapse = document.querySelector('.navbar-collapse');
                    if (navbarCollapse && navbarCollapse.classList.contains('show')) {
                        new bootstrap.Collapse(navbarCollapse).hide();
                    }
                });
            });

            window.addEventListener('scroll', () => {
                let current = '';
                const scrollY = window.pageYOffset;
                sections.forEach(section => {
                    const sectionTop = section.offsetTop - 100;
                    const sectionHeight = section.offsetHeight;
                    if (scrollY >= sectionTop && scrollY < sectionTop + sectionHeight) {
                        current = section.getAttribute('id');
                    }
                });

                if (current) {
                    topNavLinks.forEach(link => {
                        link.classList.remove('active');
                        if (link.getAttribute('href') === `#${current}`) {
                            link.classList.add('active');
                        }
                    });

                    if (mobNavHome) mobNavHome.classList.toggle('active', current === 'home' || current === 'about');
                    if (mobNavServices) mobNavServices.classList.toggle('active', current === 'services');
                    if (mobNavGallery) mobNavGallery.classList.toggle('active', current === 'gallery');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
