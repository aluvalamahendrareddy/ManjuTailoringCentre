<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manju Ladies Tailoring Centre</title>
    
    <!-- SEO & Open Graph Meta Tags (for WhatsApp, Facebook & Google Previews) -->
    <meta name="description" content="Manju Ladies Tailoring Centre - Best Ladies Tailor in Gadwal. Specialist in Designer Blouses, Kids Frocks, Pattu Langa & Bridal stitching. Managed by Shankaramma Garu." />
    <meta name="keywords" content="Ladies Tailor in Gadwal, Blouse Stitching, Designer Blouse, Gadwal Tailoring, Shankaramma Tailor, Kids dresses Gadwal" />
    
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Manju Ladies Tailoring Centre" />
    <meta property="og:title" content="@(ViewData["OgTitle"] ?? "Manju Ladies Tailoring Centre - Gadwal")" />
    <meta property="og:description" content="@(ViewData["OgDescription"] ?? "Specialist in Designer Saree Blouses, Kids Frocks, Pattu Langa & Alterations. Managed by Shankaramma Garu.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "https://manjuladiestailoringcentre.onrender.com/images/og-preview.jpg")" />
    <meta property="og:image:secure_url" content="@(ViewData["OgImage"] ?? "https://manjuladiestailoringcentre.onrender.com/images/og-preview.jpg")" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="@(ViewData["OgUrl"] ?? "https://manjuladiestailoringcentre.onrender.com")" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["OgTitle"] ?? "Manju Ladies Tailoring Centre - Gadwal")" />
    <meta name="twitter:description" content="@(ViewData["OgDescription"] ?? "Specialist in Designer Saree Blouses, Kids Frocks, Pattu Langa & Alterations.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? "https://manjuladiestailoringcentre.onrender.com/images/og-preview.jpg")" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    
    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top shadow-sm">
            <div class="container text-uppercase">
                <a class="navbar-brand fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <!-- Shown on mobile only (< 576px) -->
                    <span class="d-inline d-sm-none"><span class="fw-bold">MLTC</span></span>
                    <!-- Shown on tablet and desktop (>= 576px) -->
                    <span class="d-none d-sm-inline"><span class="fw-bold">Manju</span> <span class="fw-light">Ladies Tailoring</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Services">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Gallery">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3" style="margin-top: 80px;">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white pt-5 pb-3">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="text-uppercase mb-4 fw-bold" style="color: #d4af37;">Manju Ladies Tailoring</h5>
                    <p>Experience the perfect blend of tradition and trend. We specialize in crafting elegant outfits that make you feel confident and beautiful.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="text-uppercase mb-4 fw-bold" style="color: #d4af37;">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a asp-action="About" class="text-white-50 text-decoration-none">About Us</a></li>
                        <li><a asp-action="Services" class="text-white-50 text-decoration-none">Our Services</a></li>
                        <li><a asp-action="Gallery" class="text-white-50 text-decoration-none">Design Gallery</a></li>
                        <li><a asp-action="Contact" class="text-white-50 text-decoration-none">Book Appointment</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="text-uppercase mb-4 fw-bold" style="color: #d4af37;">Contact Info</h5>
                    <p><i class="bi bi-geo-alt-fill me-2"></i> Gandhi Chowk, Ashok Nagar, Gadwal, TS - 509125</p>
                    <p><i class="bi bi-clock-fill me-2"></i> Mon - Sat: 10:00 AM - 08:00 PM</p>
                    <p><i class="bi bi-building-fill-check me-2"></i> Landmark: Pallavi Herbal Beauty Parlour</p>
                    <div class="mt-3">
                        <a href="https://wa.me/919652848029" class="btn btn-outline-light btn-sm"><i class="bi bi-whatsapp me-2"></i>WhatsApp Us</a>
                    </div>
                </div>
            </div>
            <hr class="mt-4 mb-4 border-white-50">
            <div class="text-center text-white-50">
                <small>&copy; @DateTime.Now.Year Manju Ladies Tailoring Centre. Managed by Shankaramma. Crafted for Elegance.</small>
            </div>
        </div>
    </footer>

    <!-- WhatsApp Floating Button (Hidden on small mobile since bottom bar has WhatsApp, visible on tablet/desktop) -->
    <a href="https://wa.me/919652848029" class="whatsapp-float d-none d-md-flex" target="_blank" title="Chat on WhatsApp">
        <i class="bi bi-whatsapp"></i>
    </a>

    <!-- Mobile Bottom Navigation Bar (1-Tap Thumb Access for Mobile Users) -->
    <nav class="mobile-bottom-nav d-md-none">
        <a asp-controller="Home" asp-action="Index" class="nav-item-mobile @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
            <i class="bi bi-house-door"></i>
            <span>Home</span>
        </a>
        <a asp-controller="Home" asp-action="Gallery" class="nav-item-mobile @(ViewContext.RouteData.Values["action"]?.ToString() == "Gallery" ? "active" : "")">
            <i class="bi bi-images"></i>
            <span>Gallery</span>
        </a>
        <a asp-controller="Home" asp-action="Services" class="nav-item-mobile @(ViewContext.RouteData.Values["action"]?.ToString() == "Services" ? "active" : "")">
            <i class="bi bi-scissors"></i>
            <span>Services</span>
        </a>
        <a href="https://wa.me/919652848029" target="_blank" class="nav-item-mobile nav-wa-mobile">
            <i class="bi bi-whatsapp"></i>
            <span>WhatsApp</span>
        </a>
        <a href="tel:9652848029" class="nav-item-mobile nav-call-mobile">
            <i class="bi bi-telephone-fill"></i>
            <span>Call</span>
        </a>
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
