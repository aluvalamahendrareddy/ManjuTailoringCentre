@{
    ViewData["Title"] = "Admin Login";
    Layout = null; // Standalone page, no navbar/footer
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login – Manju Ladies Tailoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --primary: #c2185b;
            --primary-hover: #ad1457;
            --accent: #d4af37;
        }
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background: #fff7f9;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            min-height: 100dvh;
        }
        .login-card {
            background: white;
            border-radius: 24px;
            padding: 2.2rem;
            width: 90%;
            max-width: 390px;
            box-shadow: 0 10px 35px rgba(194, 24, 91, 0.08);
            border: 1px solid rgba(194, 24, 91, 0.1);
        }
        .brand {
            color: var(--primary);
            font-weight: 700;
        }
        .btn-login {
            background: var(--primary);
            border: none;
            border-radius: 30px;
            padding: 0.65rem;
            font-size: 0.95rem;
            font-weight: 600;
            transition: 0.2s;
        }
        .btn-login:hover {
            background: var(--primary-hover);
        }
        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 0.2rem rgba(194, 24, 91, 0.15);
        }
        .password-toggle-btn {
            border: none;
            background: transparent;
            color: #888;
            font-size: 1.15rem;
            padding: 0.4rem 0.8rem;
            cursor: pointer;
            z-index: 5;
        }
        .password-toggle-btn:hover {
            color: var(--primary);
        }
        @@media (max-width: 576px) {
            body {
                align-items: center;
                overflow: hidden;
            }
            .login-card {
                padding: 1.5rem !important;
                border-radius: 20px !important;
                margin: 0.75rem auto;
            }
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-3">
            <!-- Brand name: On desktop "Manju Ladies Tailoring", on mobile scissors icon + "MLTC" -->
            <h4 class="brand mb-1">
                <!-- Desktop name (>= 576px): No scissors on left -->
                <span class="d-none d-sm-inline">Manju Ladies Tailoring</span>
                <!-- Mobile name (< 576px): Scissors icon on left of MLTC -->
                <span class="d-inline d-sm-none fs-3">
                    <i class="bi bi-scissors me-1" style="color: var(--primary);"></i>MLTC
                </span>
            </h4>
            <p class="text-muted small mb-0">Admin Portal</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger rounded-3 py-2 small mb-3">
                <i class="bi bi-exclamation-circle me-1"></i>@ViewBag.Error
            </div>
        }

        <form method="post" asp-action="Login">
            <div class="mb-3">
                <label class="form-label fw-bold small mb-1">Username</label>
                <input type="text" name="username" class="form-control rounded-pill px-3"
                       placeholder="Enter username" style="font-size: 0.9rem;" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small mb-1">Password</label>
                <div class="position-relative">
                    <input type="password" name="password" id="passwordInput" class="form-control rounded-pill ps-3 pe-5"
                           placeholder="Enter password" style="font-size: 0.9rem;" required />
                    <!-- Show/Hide password eye toggle button for mobile & web -->
                    <button type="button" class="password-toggle-btn position-absolute end-0 top-50 translate-middle-y"
                            onclick="togglePasswordVisibility()" aria-label="Toggle password visibility">
                        <i class="bi bi-eye" id="passwordToggleIcon"></i>
                    </button>
                </div>
            </div>
            <button type="submit" class="btn btn-login w-100 text-white mt-1 shadow-sm">
                <i class="bi bi-box-arrow-in-right me-2"></i>Login
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="/" class="text-muted small text-decoration-none" style="font-size: 0.8rem;">
                <i class="bi bi-arrow-left me-1"></i>Back to Website
            </a>
        </div>
    </div>

    <script>
        function togglePasswordVisibility() {
            const pwdInput = document.getElementById('passwordInput');
            const icon = document.getElementById('passwordToggleIcon');
            if (pwdInput.type === 'password') {
                pwdInput.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                pwdInput.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
</body>
</html>
