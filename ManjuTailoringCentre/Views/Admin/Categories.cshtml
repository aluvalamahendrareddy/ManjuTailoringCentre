@model List<ManjuTailoringCentre.Models.CategoryItem>
@{
    ViewData["Title"] = "Manage Categories";
    Layout = null;
    var counts = ViewBag.PhotoCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Categories – MLTC Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root { 
            --primary: #c2185b;
            --primary-hover: #ad1457;
            --accent: #d4af37;
            --bg-light: #fff7f9;
        }
        body { background: var(--bg-light); font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif; }
        .sidebar { background: var(--primary); min-height: 100vh; width: 240px; position: fixed; top: 0; left: 0; z-index: 100; padding: 2rem 1rem; }
        .sidebar .brand { color: white; font-size: 1.25rem; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,0.25); padding-bottom: 1rem; margin-bottom: 1.5rem; }
        .sidebar a { color: rgba(255,255,255,0.85); text-decoration: none; display: block; padding: 0.65rem 1rem; border-radius: 10px; margin-bottom: 0.5rem; transition: 0.2s; font-weight: 500; }
        .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.2); color: white; }
        .main-content { margin-left: 240px; padding: 2rem; }
        .card { border-radius: 16px; border: 1px solid rgba(194,24,91,0.08); box-shadow: 0 4px 20px rgba(0,0,0,0.04); }

        /* Admin Mobile Bottom Navigation */
        .admin-bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 56px;
            padding-top: 4px;
            padding-bottom: max(env(safe-area-inset-bottom, 0px), 4px);
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(12px);
            border-top: 1px solid rgba(194, 24, 91, 0.15);
            box-shadow: 0 -4px 16px rgba(0,0,0,0.08);
            display: flex;
            align-items: flex-start;
            justify-content: space-around;
            z-index: 1040;
        }
        .admin-nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            color: #666;
            text-decoration: none;
            padding: 2px 4px;
            flex: 1;
            text-align: center;
            font-size: 0.65rem;
            font-weight: 500;
        }
        .admin-nav-item i { font-size: 1.15rem; line-height: 1; margin-bottom: 2px; }
        .admin-nav-item span { line-height: 1; }
        .admin-nav-item.active { color: var(--primary) !important; font-weight: 700; }
        .admin-nav-item:hover { color: var(--primary); }

        @@media (max-width: 768px) {
            .sidebar { display: none !important; }
            .main-content { margin-left: 0 !important; padding: 0.75rem 0.5rem 75px !important; }
        }
    </style>
</head>
<body>
    <!-- Desktop Sidebar -->
    <div class="sidebar d-none d-md-block">
        <div class="brand">
            <i class="bi bi-scissors me-2"></i>MLTC Admin
        </div>
        <a href="/Admin/Dashboard"><i class="bi bi-images me-2"></i>Gallery</a>
        <a href="/Admin/Categories" class="active"><i class="bi bi-tags me-2"></i>Categories</a>
        <a href="/" target="_blank"><i class="bi bi-globe me-2"></i>View Website</a>
        <form method="post" asp-action="Logout" class="mt-auto">
            <button type="submit" class="btn text-white w-100 text-start ps-3" style="background:none; border:none; color: rgba(255,255,255,0.85); font-weight: 500;">
                <i class="bi bi-box-arrow-left me-2"></i>Logout
            </button>
        </form>
    </div>

    <!-- Mobile Top Bar -->
    <div class="d-md-none d-flex justify-content-between align-items-center px-3 py-2" style="background: var(--primary); color: white;">
        <span class="fw-bold fs-6"><i class="bi bi-scissors me-2"></i>MLTC Admin</span>
        <a href="/Admin/Dashboard" class="btn btn-sm btn-light rounded-pill px-3 py-1" style="color: var(--primary); font-size: 0.75rem; font-weight: 600;">
            <i class="bi bi-arrow-left me-1"></i>Gallery
        </a>
    </div>

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1" style="color: var(--primary);"><i class="bi bi-tags me-2"></i>Manage Design Categories</h4>
                <p class="text-muted mb-0 small">Add, rename, or remove categories. Changes immediately update your upload dropdown and customer gallery.</p>
            </div>
            <a href="/Admin/Dashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-none d-md-inline-block">
                <i class="bi bi-arrow-left me-1"></i>Back to Gallery
            </a>
        </div>

        <!-- Add Category Form (Compact & Sleek) -->
        <div class="card mb-3 bg-white p-3 shadow-sm rounded-4">
            <h6 class="fw-bold mb-2"><i class="bi bi-plus-circle me-1" style="color: var(--primary);"></i>Add New Category</h6>
            <form method="post" asp-action="AddCategory" class="row g-2 align-items-center">
                <input type="hidden" name="returnUrl" value="categories" />
                <div class="col-sm-8 col-md-6 col-lg-5">
                    <input type="text" name="categoryName" class="form-control rounded-pill px-3" placeholder="e.g. Crop Top, Maggam Work Blouses" required style="font-size: 0.9rem;" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn rounded-pill px-4 text-white" style="background: var(--primary); font-size: 0.9rem; font-weight: 600;">
                        <i class="bi bi-check2 me-1"></i>Save Category
                    </button>
                </div>
            </form>
        </div>

        <!-- Categories Table with Pen Edit & Trash Delete Actions -->
        <div class="card bg-white p-3 p-md-4 shadow-sm rounded-4">
            <h6 class="fw-bold mb-3">All Active Categories (@Model.Count)</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light" style="font-size: 0.85rem;">
                        <tr>
                            <th style="width: 45px;">#</th>
                            <th>Category Name</th>
                            <th style="width: 120px;" class="text-center">Photos</th>
                            <th style="width: 120px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 0.9rem;">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var cat = Model[i];
                            var count = counts.ContainsKey(cat.Name) ? counts[cat.Name] : 0;
                            <tr>
                                <td class="text-muted fw-bold small">@(i + 1)</td>
                                <td>
                                    <span class="fw-semibold text-dark">@cat.Name</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-light text-dark border px-2 py-1 small">
                                        <i class="bi bi-image me-1 text-muted"></i>@count photo(s)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Pen Icon Button to open Rename Dialog -->
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-circle"
                                                style="width: 34px; height: 34px; padding: 0; display: inline-flex; align-items: center; justify-content: center;"
                                                onclick="openRenameModal(@cat.Id, '@cat.Name.Replace("'", "\\'")')"
                                                title="Rename Category">
                                            <i class="bi bi-pencil-fill" style="font-size: 0.85rem;"></i>
                                        </button>
                                        <!-- Trash Icon Button to open Delete Confirmation Dialog -->
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                                                style="width: 34px; height: 34px; padding: 0; display: inline-flex; align-items: center; justify-content: center;"
                                                onclick="openDeleteModal(@cat.Id, '@cat.Name.Replace("'", "\\'")')"
                                                title="Delete Category">
                                            <i class="bi bi-trash3-fill" style="font-size: 0.85rem;"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Rename Category Modal Dialog -->
    <div class="modal fade" id="renameModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header text-white" style="background: var(--primary);">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Rename Category</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="RenameCategory">
                    <div class="modal-body p-4">
                        <input type="hidden" name="id" id="modalRenameId" />
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Current Name</label>
                            <input type="text" id="modalOldName" class="form-control rounded-pill bg-light" readonly disabled />
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold">New Category Name</label>
                            <input type="text" name="newName" id="modalNewName" class="form-control rounded-pill px-3" required />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-4 justify-content-end gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn text-white rounded-pill px-4" style="background: var(--primary); font-weight: 600;">
                            <i class="bi bi-check2 me-1"></i>Save Rename
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal Dialog -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-trash3 me-2"></i>Delete Category</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="DeleteCategory">
                    <div class="modal-body p-4 text-center">
                        <input type="hidden" name="id" id="modalDeleteId" />
                        <input type="hidden" name="returnUrl" value="categories" />
                        <div class="mb-3">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Are you sure?</h5>
                        <p class="text-muted mb-0">Do you want to permanently delete category <strong id="modalDeleteName" class="text-dark"></strong>?</p>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-4 justify-content-center gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4" style="font-weight: 600;">
                            <i class="bi bi-trash3 me-1"></i>Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Mobile Admin Bottom Navigation Bar -->
    <nav class="admin-bottom-nav d-md-none">
        <a href="/Admin/Dashboard" class="admin-nav-item">
            <i class="bi bi-images"></i>
            <span>Gallery</span>
        </a>
        <a href="/Admin/Categories" class="admin-nav-item active">
            <i class="bi bi-tags"></i>
            <span>Categories</span>
        </a>
        <a href="/" target="_blank" class="admin-nav-item">
            <i class="bi bi-globe"></i>
            <span>Website</span>
        </a>
        <form method="post" asp-action="Logout" class="admin-nav-item p-0 m-0" style="background:none; border:none;">
            <button type="submit" class="admin-nav-item w-100 h-100 p-0 m-0" style="background:none; border:none; color: inherit;">
                <i class="bi bi-box-arrow-left"></i>
                <span>Logout</span>
            </button>
        </form>
    </nav>

    <!-- Toast Notification for Feedback -->
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3 mb-5 mb-md-3" style="z-index: 1090;">
            <div id="adminToast" class="toast align-items-center text-white @(TempData["Success"] != null ? "bg-success" : "bg-danger") border-0 rounded-pill px-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body fw-bold py-2">
                        <i class="bi @(TempData["Success"] != null ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                        @(TempData["Success"] ?? TempData["Error"])
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Modal openers for Rename & Delete
        function openRenameModal(id, name) {
            document.getElementById('modalRenameId').value = id;
            document.getElementById('modalOldName').value = name;
            document.getElementById('modalNewName').value = name;
            new bootstrap.Modal(document.getElementById('renameModal')).show();
            setTimeout(() => {
                const input = document.getElementById('modalNewName');
                input.focus();
                input.select();
            }, 400);
        }

        function openDeleteModal(id, name) {
            document.getElementById('modalDeleteId').value = id;
            document.getElementById('modalDeleteName').textContent = `"${name}"`;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        // Auto-show Toast notification on page load if message exists
        document.addEventListener('DOMContentLoaded', function () {
            const toastEl = document.getElementById('adminToast');
            if (toastEl) {
                const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                toast.show();
            }
        });
    </script>
</body>
</html>
