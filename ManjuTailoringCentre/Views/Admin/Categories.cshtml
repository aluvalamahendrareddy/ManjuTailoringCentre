@model List<ManjuTailoringCentre.Models.CategoryItem>
@{
    ViewData["Title"] = "Manage Categories";
    Layout = null;
    var counts = ViewBag.PhotoCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Categories – MLTC Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root { 
            --primary: #c2185b;
            --primary-hover: #ad1457;
            --accent: #d4af37;
            --bg-light: #fff7f9;
        }
        body { background: var(--bg-light); font-family: 'Segoe UI', sans-serif; }
        .sidebar { background: var(--primary); min-height: 100vh; width: 240px; position: fixed; top: 0; left: 0; z-index: 100; padding: 2rem 1rem; }
        .sidebar .brand { color: white; font-size: 1.25rem; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,0.25); padding-bottom: 1rem; margin-bottom: 1.5rem; }
        .sidebar a { color: rgba(255,255,255,0.85); text-decoration: none; display: block; padding: 0.65rem 1rem; border-radius: 10px; margin-bottom: 0.5rem; transition: 0.2s; font-weight: 500; }
        .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.2); color: white; }
        .main-content { margin-left: 240px; padding: 2rem; }
        .card { border-radius: 16px; border: 1px solid rgba(194,24,91,0.08); box-shadow: 0 4px 20px rgba(0,0,0,0.04); }
        @@media (max-width: 768px) {
            .sidebar { width: 100%; min-height: auto; position: relative; }
            .main-content { margin-left: 0; padding: 1rem; }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="brand">
            <i class="bi bi-scissors me-2"></i>MLTC Admin
        </div>
        <a href="/admin"><i class="bi bi-images me-2"></i>Gallery</a>
        <a href="/admin/categories" class="active"><i class="bi bi-tags me-2"></i>Categories</a>
        <a href="/" target="_blank"><i class="bi bi-globe me-2"></i>View Website</a>
        <form method="post" asp-action="Logout" class="mt-auto">
            <button type="submit" class="btn text-white w-100 text-start ps-3" style="background:none; border:none; color: rgba(255,255,255,0.85); font-weight: 500;">
                <i class="bi bi-box-arrow-left me-2"></i>Logout
            </button>
        </form>
    </div>

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1" style="color: var(--primary);"><i class="bi bi-tags me-2"></i>Manage Design Categories</h3>
                <p class="text-muted mb-0">Add, rename, or remove categories. Changes immediately update your upload dropdown and customer gallery.</p>
            </div>
            <a href="/admin" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i>Back to Gallery
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Add Category Form -->
        <div class="card mb-4 bg-white p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2" style="color: var(--primary);"></i>Add New Category</h5>
            <form method="post" asp-action="AddCategory" class="row g-3 align-items-center">
                <input type="hidden" name="returnUrl" value="categories" />
                <div class="col-md-6 col-lg-5">
                    <input type="text" name="categoryName" class="form-control form-control-lg rounded-pill" placeholder="e.g. Maggam Work Blouses" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-lg rounded-pill px-4 text-white" style="background: var(--primary);">
                        <i class="bi bi-check2 me-1"></i>Save Category
                    </button>
                </div>
            </form>
        </div>

        <!-- Categories Table -->
        <div class="card bg-white p-4">
            <h5 class="fw-bold mb-3">All Active Categories (@Model.Count)</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">#</th>
                            <th>Category Name</th>
                            <th style="width: 160px;" class="text-center">Photos Tagged</th>
                            <th style="width: 280px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var cat = Model[i];
                            var count = counts.ContainsKey(cat.Name) ? counts[cat.Name] : 0;
                            <tr>
                                <td class="text-muted fw-bold">@(i + 1)</td>
                                <td>
                                    <form method="post" asp-action="RenameCategory" class="d-flex align-items-center gap-2 m-0" id="form-@cat.Id">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <input type="text" name="newName" value="@cat.Name" class="form-control rounded-pill" style="max-width: 320px;" required />
                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Save name change">
                                            <i class="bi bi-check-lg me-1"></i>Rename
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-light text-dark border px-3 py-2">
                                        <i class="bi bi-image me-1 text-muted"></i>@count photo(s)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-action="DeleteCategory" onsubmit="return confirm('Are you sure you want to delete category \'@cat.Name\'?');" class="d-inline">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <input type="hidden" name="returnUrl" value="categories" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="bi bi-trash3 me-1"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
