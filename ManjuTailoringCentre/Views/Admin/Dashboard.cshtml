@model List<ManjuTailoringCentre.Models.GalleryPhoto>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
    var categoriesList = ViewBag.CategoriesList as List<ManjuTailoringCentre.Models.CategoryItem> ?? new List<ManjuTailoringCentre.Models.CategoryItem>();
    var categoryNames = categoriesList.Select(c => c.Name.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard – Manju Tailoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root { 
            --primary: #c2185b; /* Vibrant Raspberry / Rani Pink */
            --primary-hover: #ad1457;
            --accent: #d4af37;  /* Warm Gold */
            --bg-light: #fff7f9;
        }
        body { background: var(--bg-light); font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif; }
        .sidebar { background: var(--primary); min-height: 100vh; width: 240px; position: fixed; top: 0; left: 0; z-index: 100; padding: 2rem 1rem; }
        .sidebar .brand { color: white; font-size: 1.25rem; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,0.25); padding-bottom: 1rem; margin-bottom: 1.5rem; }
        .sidebar a { color: rgba(255,255,255,0.85); text-decoration: none; display: block; padding: 0.65rem 1rem; border-radius: 10px; margin-bottom: 0.5rem; transition: 0.2s; font-weight: 500; }
        .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.2); color: white; }
        .main-content { margin-left: 240px; padding: 2rem; }
        .stat-card { background: white; border-radius: 16px; padding: 1.5rem; box-shadow: 0 4px 20px rgba(194,24,91,0.06); border: 1px solid rgba(194,24,91,0.08); }
        .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 1.25rem; }
        .photo-item { position: relative; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.08); background: white; border: 1px solid rgba(0,0,0,0.06); transition: border-color 0.2s; }
        .photo-item.selected { border: 2px solid var(--primary) !important; box-shadow: 0 0 10px rgba(194,24,91,0.25) !important; }
        .photo-thumb-wrap { position: relative; aspect-ratio: 1; overflow: hidden; background: #eee; }
        .photo-thumb-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
        .photo-item:hover .photo-thumb-wrap img { transform: scale(1.05); }
        .delete-btn { position: absolute; top: 8px; right: 8px; background: #e53935; border: 2px solid white; color: white; border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: transform 0.2s, background 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.35); z-index: 5; font-size: 13px; }
        .delete-btn:hover { background: #b71c1c; transform: scale(1.15); }
        .photo-details { padding: 0.6rem 0.5rem; background: white; }
        
        /* Compact, non-trimmed category dropdown */
        .category-select-admin {
            font-size: 0.76rem !important;
            padding: 0.22rem 1.4rem 0.22rem 0.45rem !important;
            height: 30px !important;
            border-radius: 50px !important;
            text-overflow: ellipsis;
            white-space: nowrap;
            overflow: hidden;
            border-color: #f8bbd0 !important;
            background-color: #fff9fa !important;
            color: #333 !important;
            font-weight: 500;
        }

        .preview-thumb-wrap { position: relative; display: inline-block; margin: 4px; }
        .preview-thumb { width: 85px; height: 85px; object-fit: cover; border-radius: 10px; border: 2px solid white; box-shadow: 0 3px 10px rgba(0,0,0,0.15); display: block; }
        .preview-remove-btn { position: absolute; top: -8px; right: -8px; background: #e53935; border: 2px solid white; color: white; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.3); }
        .preview-remove-btn:hover { background: #b71c1c; transform: scale(1.2); }

        /* Admin Mobile Bottom Navigation */
        .admin-bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 56px;
            padding-top: 4px;
            padding-bottom: max(env(safe-area-inset-bottom, 0px), 4px);
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(12px);
            border-top: 1px solid rgba(194, 24, 91, 0.15);
            box-shadow: 0 -4px 16px rgba(0,0,0,0.08);
            display: flex;
            align-items: flex-start;
            justify-content: space-around;
            z-index: 1040;
        }
        .admin-nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            color: #666;
            text-decoration: none;
            padding: 2px 4px;
            flex: 1;
            text-align: center;
            font-size: 0.65rem;
            font-weight: 500;
        }
        .admin-nav-item i { font-size: 1.15rem; line-height: 1; margin-bottom: 2px; }
        .admin-nav-item span { line-height: 1; }
        .admin-nav-item.active { color: var(--primary) !important; font-weight: 700; }
        .admin-nav-item:hover { color: var(--primary); }

        @@media (max-width: 768px) {
            .sidebar { display: none !important; }
            .main-content { margin-left: 0 !important; padding: 0.75rem 0.5rem 75px !important; }

            /* 3 images per row on mobile in Admin Gallery */
            .photo-grid {
                grid-template-columns: repeat(3, 1fr) !important;
                gap: 0.4rem !important;
            }
            .photo-item {
                border-radius: 8px !important;
            }
            .photo-details {
                padding: 0.25rem 0.2rem !important;
            }
            .category-select-admin {
                font-size: 0.63rem !important;
                padding: 0.15rem 1rem 0.15rem 0.2rem !important;
                height: 24px !important;
            }
            .photo-details small {
                display: none !important;
            }
            .delete-btn {
                width: 22px !important;
                height: 22px !important;
                top: 4px !important;
                right: 4px !important;
                font-size: 10px !important;
            }
            .stat-card {
                padding: 0.75rem 0.5rem !important;
            }
        }
    </style>
</head>
<body>
    <!-- Desktop Sidebar -->
    <div class="sidebar d-none d-md-block">
        <div class="brand">
            <i class="bi bi-scissors me-2"></i>MLTC Admin
        </div>
        <a href="/Admin/Dashboard" class="active"><i class="bi bi-images me-2"></i>Gallery</a>
        <a href="/Admin/Categories"><i class="bi bi-tags me-2"></i>Categories</a>
        <a href="/" target="_blank"><i class="bi bi-globe me-2"></i>View Website</a>
        <form method="post" asp-action="Logout" class="mt-auto" style="margin-top: auto !important;">
            <button type="submit" class="btn text-white w-100 text-start ps-3" style="background:none; border:none; color: rgba(255,255,255,0.85); font-weight: 500;">
                <i class="bi bi-box-arrow-left me-2"></i>Logout
            </button>
        </form>
    </div>

    <!-- Mobile Top Header -->
    <div class="d-md-none d-flex justify-content-between align-items-center px-3 py-2" style="background: var(--primary); color: white;">
        <span class="fw-bold fs-6"><i class="bi bi-scissors me-2"></i>MLTC Admin</span>
        <a href="/Admin/Categories" class="btn btn-sm btn-light rounded-pill px-3 py-1" style="color: var(--primary); font-size: 0.75rem; font-weight: 600;">
            <i class="bi bi-tags me-1"></i>Categories
        </a>
    </div>

    <!-- Main Content -->
    <div class="main-content">

        <!-- Stats Row -->
        <div class="row g-2 g-md-3 mb-3 mb-md-4">
            <div class="col-4 col-md-4">
                <div class="stat-card p-2 p-md-3 text-center text-md-start">
                    <h3 class="fw-bold mb-0" style="color: var(--primary); font-size: clamp(1.1rem, 3.8vw, 1.7rem);">@Model.Count</h3>
                    <p class="mb-0 text-muted" style="font-size: 0.75rem;">Total Photos</p>
                </div>
            </div>
            <div class="col-4 col-md-4">
                <div class="stat-card p-2 p-md-3 text-center text-md-start">
                    <h3 class="fw-bold mb-0" style="color: var(--primary); font-size: clamp(1.1rem, 3.8vw, 1.7rem);">@categoryNames.Count</h3>
                    <p class="mb-0 text-muted" style="font-size: 0.75rem;">Categories</p>
                </div>
            </div>
            <!-- Item 1: Storage Card showing MB / 25 GB like C drive -->
            <div class="col-4 col-md-4">
                <div class="stat-card p-2 p-md-3 text-center text-md-start">
                    <h3 class="fw-bold mb-0" style="color: var(--accent); font-size: clamp(0.95rem, 3.5vw, 1.5rem); white-space: nowrap;">@(ViewBag.StorageUsedMB ?? 0) MB / 25 GB</h3>
                    <p class="mb-0 text-muted" style="font-size: 0.75rem;">Cloud Storage</p>
                </div>
            </div>
        </div>

        <!-- Upload Section (Compact & Intuitive) -->
        <div class="card border-0 rounded-4 shadow-sm mb-3 mb-md-4" style="overflow: hidden;">
            <div class="card-header py-2 py-md-3 d-flex justify-content-between align-items-center" style="background: var(--primary); color: white;">
                <h6 class="mb-0 fw-bold"><i class="bi bi-cloud-upload me-2"></i>Upload Design Photos</h6>
                <a href="/admin/categories" class="btn btn-sm btn-light rounded-pill px-3 fw-bold d-none d-md-inline-block" style="color: var(--primary); font-size: 0.8rem;">
                    <i class="bi bi-tags me-1"></i>Manage Categories
                </a>
            </div>
            <div class="card-body p-3 p-md-4">
                <form method="post" asp-action="Upload" enctype="multipart/form-data" id="uploadForm">
                    <div class="row g-2 g-md-3 align-items-center">
                        <div class="col-12 col-md-4 col-lg-3">
                            <label class="form-label fw-bold mb-1 small">1. Choose Category</label>
                            <select name="category" class="form-select rounded-pill px-3" style="font-size: 0.88rem;">
                                @foreach (var cat in categoryNames)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-8 col-lg-6">
                            <label class="form-label fw-bold mb-1 small">2. Select Photos (Up to 20 at once)</label>
                            <input type="file" name="photos" id="photosInput" class="form-control rounded-pill px-3" style="font-size: 0.88rem;"
                                   accept="image/jpeg,image/jpg,image/png,image/webp" multiple required />
                        </div>
                        <div class="col-12 col-lg-3 text-lg-end pt-lg-4">
                            <button type="submit" class="btn rounded-pill px-4 text-white w-100"
                                    style="background: var(--primary); font-weight: 600; font-size: 0.9rem;">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i>Upload Photos
                            </button>
                        </div>
                        <div class="col-12" id="preview-container" style="display:none;">
                            <hr class="my-2" />
                            <div class="d-flex flex-wrap gap-2 mt-2" id="preview-grid"></div>
                            <small class="text-muted d-block mt-2" id="preview-count"></small>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Category Filter Tabs for Admin -->
        <div class="card border-0 shadow-sm rounded-4 mb-3" style="background: #ffffff;">
            <div class="card-body p-2 p-md-3">
                <div class="d-flex flex-wrap gap-1 gap-md-2 align-items-center">
                    <span class="text-muted small fw-bold me-1"><i class="bi bi-funnel-fill me-1" style="color: var(--primary);"></i>Filter:</span>
                    <button type="button" class="btn btn-sm rounded-pill px-2 px-md-3 admin-filter-btn active-filter"
                            style="background: var(--primary); color: white; border: none; font-weight: 600; font-size: 0.78rem;"
                            onclick="filterAdminGallery('all', this)">
                        All (@Model.Count)
                    </button>
                    @foreach (var cat in categoryNames)
                    {
                        var catCount = Model.Count(p => p.Category == cat);
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 px-md-3 admin-filter-btn"
                                style="font-weight: 500; font-size: 0.78rem;"
                                onclick="filterAdminGallery('@cat', this)">
                            @cat (@catCount)
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Item 3: Bulk Delete Form & Gallery Grid with Multi-Select -->
        <form method="post" asp-action="DeleteMultiple" id="bulkDeleteForm" onsubmit="return confirmBulkDelete();">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                <div class="d-flex align-items-center gap-2">
                    <h6 class="mb-0 fw-bold" id="adminGalleryHeader"><i class="bi bi-images me-1"></i>Gallery Photos (@Model.Count)</h6>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0" style="font-size: 0.75rem;" onclick="toggleSelectAll()">
                        <span id="selectAllText">Select All</span>
                    </button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="submit" id="deleteSelectedBtn" class="btn btn-sm btn-danger rounded-pill px-3 py-1 d-none" style="font-size: 0.78rem; font-weight: 600;">
                        <i class="bi bi-trash3-fill me-1"></i>Delete Selected (<span id="selectedCountBadge">0</span>)
                    </button>
                    <small class="text-muted small d-none d-md-block">Tip: Check boxes to delete multiple</small>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-image" style="font-size: 4rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No photos uploaded yet. Upload your first design above!</p>
                </div>
            }
            else
            {
                <!-- Photo Grid: 3 images per row on mobile, auto-fill on desktop -->
                <div class="photo-grid" id="adminPhotoGrid">
                    @foreach (var photo in Model)
                    {
                        <div class="photo-item" data-category="@photo.Category" id="photo-card-@photo.Id">
                            <div class="photo-thumb-wrap">
                                <!-- Multi-select checkbox -->
                                <div class="position-absolute top-0 start-0 m-1" style="z-index: 6;">
                                    <input type="checkbox" name="ids" value="@photo.Id" class="photo-select-checkbox form-check-input" 
                                           style="width: 20px; height: 20px; cursor: pointer; border: 2px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.4);" 
                                           onchange="updateBulkDeleteState()" />
                                </div>
                                <img src="@photo.ImageUrl" alt="@photo.Category" loading="lazy" />
                                <button type="button" class="delete-btn" title="Delete photo" onclick="deleteSinglePhoto(@photo.Id)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                            <div class="photo-details">
                                <div class="d-flex align-items-center m-0">
                                    <select class="form-select form-select-sm category-select-admin w-100" 
                                            onchange="updateCategoryInPlace(@photo.Id, this.value)" title="Change Category">
                                        @foreach (var cat in categoryNames)
                                        {
                                            <option value="@cat" selected="@(photo.Category == cat ? "selected" : null)">@cat</option>
                                        }
                                    </select>
                                </div>
                                <small class="text-muted d-block text-center mt-1" style="font-size: 10px;">Select to move</small>
                            </div>
                        </div>
                    }
                </div>
            }
        </form>
    </div>

    <!-- Hidden form for single photo delete -->
    <form method="post" asp-action="Delete" id="singleDeleteForm" style="display:none;">
        <input type="hidden" name="id" id="singleDeleteId" />
    </form>

    <!-- Hidden form for in-place category update -->
    <form method="post" asp-action="UpdatePhotoCategory" id="singleUpdateCategoryForm" style="display:none;">
        <input type="hidden" name="photoId" id="updatePhotoId" />
        <input type="hidden" name="newCategory" id="updateNewCategory" />
    </form>

    <!-- Mobile Admin Bottom Navigation Bar -->
    <nav class="admin-bottom-nav d-md-none">
        <a href="/Admin/Dashboard" class="admin-nav-item active">
            <i class="bi bi-images"></i>
            <span>Gallery</span>
        </a>
        <a href="/Admin/Categories" class="admin-nav-item">
            <i class="bi bi-tags"></i>
            <span>Categories</span>
        </a>
        <a href="/" target="_blank" class="admin-nav-item">
            <i class="bi bi-globe"></i>
            <span>Website</span>
        </a>
        <form method="post" asp-action="Logout" class="admin-nav-item p-0 m-0" style="background:none; border:none;">
            <button type="submit" class="admin-nav-item w-100 h-100 p-0 m-0" style="background:none; border:none; color: inherit;">
                <i class="bi bi-box-arrow-left"></i>
                <span>Logout</span>
            </button>
        </form>
    </nav>

    <!-- Item 4: Floating Toast Notification (Centered, responsive, fits on all screens) -->
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="toast-container position-fixed start-50 translate-middle-x p-2" style="z-index: 2000; bottom: 70px; width: max-content; max-width: 92vw;">
            <div id="adminToast" class="toast align-items-center text-white @(TempData["Success"] != null ? "bg-success" : "bg-danger") border-0 rounded-pill px-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex align-items-center">
                    <div class="toast-body fw-bold py-2 px-1 text-center" style="font-size: 0.85rem; line-height: 1.3;">
                        <i class="bi @(TempData["Success"] != null ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>@(TempData["Success"] ?? TempData["Error"])
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-2 me-1" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastEl = document.getElementById('adminToast');
            if (toastEl) {
                const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                toast.show();
            }
        });

        // Bulk Delete selection logic
        function updateBulkDeleteState() {
            const checkboxes = document.querySelectorAll('.photo-select-checkbox:checked');
            const count = checkboxes.length;
            const btn = document.getElementById('deleteSelectedBtn');
            const badge = document.getElementById('selectedCountBadge');

            badge.textContent = count;
            if (count > 0) {
                btn.classList.remove('d-none');
            } else {
                btn.classList.add('d-none');
            }

            // Highlight selected card borders
            document.querySelectorAll('.photo-select-checkbox').forEach(cb => {
                const card = document.getElementById(`photo-card-${cb.value}`);
                if (card) {
                    if (cb.checked) {
                        card.classList.add('selected');
                    } else {
                        card.classList.remove('selected');
                    }
                }
            });
        }

        let isAllSelected = false;
        function toggleSelectAll() {
            const visibleCheckboxes = Array.from(document.querySelectorAll('#adminPhotoGrid .photo-item'))
                .filter(item => item.style.display !== 'none')
                .map(item => item.querySelector('.photo-select-checkbox'))
                .filter(Boolean);

            isAllSelected = !isAllSelected;
            visibleCheckboxes.forEach(cb => cb.checked = isAllSelected);
            document.getElementById('selectAllText').textContent = isAllSelected ? 'Deselect All' : 'Select All';
            updateBulkDeleteState();
        }

        function confirmBulkDelete() {
            const count = document.querySelectorAll('.photo-select-checkbox:checked').length;
            if (count === 0) return false;
            return confirm(`Are you sure you want to permanently delete ${count} selected photo(s)? This cannot be undone.`);
        }

        function deleteSinglePhoto(id) {
            if (confirm('Delete this photo? This cannot be undone.')) {
                document.getElementById('singleDeleteId').value = id;
                document.getElementById('singleDeleteForm').submit();
            }
        }

        function updateCategoryInPlace(photoId, newCategory) {
            document.getElementById('updatePhotoId').value = photoId;
            document.getElementById('updateNewCategory').value = newCategory;
            document.getElementById('singleUpdateCategoryForm').submit();
        }

        // Track selected files with DataTransfer so user can remove individual files with (X)
        let dt = new DataTransfer();
        const fileInput = document.getElementById('photosInput');
        const container = document.getElementById('preview-container');
        const grid = document.getElementById('preview-grid');
        const countLabel = document.getElementById('preview-count');

        fileInput.addEventListener('change', function (e) {
            const newFiles = Array.from(this.files);
            
            if (dt.items.length + newFiles.length > 20) {
                alert('You can upload a maximum of 20 photos at a time.');
                return;
            }

            newFiles.forEach(f => dt.items.add(f));
            fileInput.files = dt.files;
            renderPreviews();
        });

        function renderPreviews() {
            grid.innerHTML = '';
            if (dt.items.length === 0) {
                container.style.display = 'none';
                return;
            }

            container.style.display = 'block';
            countLabel.textContent = `${dt.items.length} photo(s) selected for upload:`;

            Array.from(dt.files).forEach((file, index) => {
                const wrap = document.createElement('div');
                wrap.className = 'preview-thumb-wrap';

                const img = document.createElement('img');
                img.className = 'preview-thumb';
                img.src = URL.createObjectURL(file);

                const removeBtn = document.createElement('button');
                removeBtn.className = 'preview-remove-btn';
                removeBtn.innerHTML = '×';
                removeBtn.type = 'button';
                removeBtn.title = 'Remove this photo';
                removeBtn.onclick = function () {
                    removeFile(index);
                };

                wrap.appendChild(img);
                wrap.appendChild(removeBtn);
                grid.appendChild(wrap);
            });
        }

        function removeFile(index) {
            const newDt = new DataTransfer();
            Array.from(dt.files).forEach((f, i) => {
                if (i !== index) newDt.items.add(f);
            });
            dt = newDt;
            fileInput.files = dt.files;
            renderPreviews();
        }

        // Filter Photos for Admin
        function filterAdminGallery(category, button) {
            document.querySelectorAll('.admin-filter-btn').forEach(btn => {
                btn.classList.remove('active-filter');
                btn.style.background = '';
                btn.style.color = '';
                btn.classList.add('btn-outline-secondary');
            });

            button.classList.add('active-filter');
            button.classList.remove('btn-outline-secondary');
            button.style.background = 'var(--primary)';
            button.style.color = 'white';

            const items = document.querySelectorAll('#adminPhotoGrid .photo-item');
            let visibleCount = 0;
            items.forEach(item => {
                const itemCat = item.getAttribute('data-category');
                if (category === 'all' || itemCat === category) {
                    item.style.display = 'block';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            const header = document.getElementById('adminGalleryHeader');
            if (category === 'all') {
                header.innerHTML = `<i class="bi bi-images me-1"></i>Gallery Photos (${visibleCount})`;
            } else {
                header.innerHTML = `<i class="bi bi-images me-1"></i>${category} (${visibleCount})`;
            }

            // Reset bulk selection
            isAllSelected = false;
            document.getElementById('selectAllText').textContent = 'Select All';
            updateBulkDeleteState();
        }
    </script>
</body>
</html>
